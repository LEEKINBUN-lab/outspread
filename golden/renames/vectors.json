{
  "schema": 1,
  "_why": "改名标记的解析规则是契约的一部分（docs/sync-contract.md「改名怎么跨端跟上」第 2、3 条）：桌面（C#）与安卓（Kotlin）各自回放这一批用例，答案必须一字不差。改任何一条决胜规则，就得在这里加一条能抓住它的向量。",
  "_shape": "每条向量：myStem = 我这台正开着的板名；entries = 仓里那份 renames.json 的条目；exists = 本轮 tree 里在仓的板名（`boards/<名>.canvas` 存在的那些）；expect = Follow 该答什么（null = 不跟，退回已知的删除语义）。",
  "_at": "at 写成定宽 UTC `yyyy-MM-ddTHH:mm:ssZ`：比较它就是 Ordinal 比字符串，而定宽保证 Ordinal 与时间同序。",
  "vectors": [
    {
      "name": "一跳，目标在仓里",
      "myStem": "周会",
      "entries": [{ "from": "周会", "to": "项目周报", "by": "PC-A", "at": "2026-10-23T21:40:00Z" }],
      "exists": ["项目周报"],
      "expect": "项目周报"
    },
    {
      "name": "链：连着跟到尽头",
      "myStem": "周会",
      "entries": [
        { "from": "周会", "to": "项目周报", "by": "PC-A", "at": "2026-10-23T21:40:00Z" },
        { "from": "项目周报", "to": "本季复盘", "by": "PC-A", "at": "2026-10-23T22:00:00Z" }
      ],
      "exists": ["本季复盘"],
      "expect": "本季复盘"
    },
    {
      "name": "环：不跟",
      "myStem": "周会",
      "entries": [
        { "from": "周会", "to": "项目周报", "by": "PC-A", "at": "2026-10-23T21:40:00Z" },
        { "from": "项目周报", "to": "周会", "by": "PC-B", "at": "2026-10-23T22:00:00Z" }
      ],
      "exists": ["周会", "项目周报"],
      "expect": null
    },
    {
      "name": "自己改回自己：不跟",
      "myStem": "周会",
      "entries": [{ "from": "周会", "to": "周会", "by": "PC-A", "at": "2026-10-23T21:40:00Z" }],
      "exists": ["周会"],
      "expect": null
    },
    {
      "name": "同一个 from 两条：at 大的赢",
      "myStem": "周会",
      "entries": [
        { "from": "周会", "to": "项目周报", "by": "PC-A", "at": "2026-10-23T21:40:00Z" },
        { "from": "周会", "to": "手机那边改的名", "by": "PHONE-B", "at": "2026-10-23T22:10:00Z" }
      ],
      "exists": ["项目周报", "手机那边改的名"],
      "expect": "手机那边改的名"
    },
    {
      "name": "at 平手：by 的 Ordinal 大的赢（两端必须算出同一条）",
      "myStem": "周会",
      "entries": [
        { "from": "周会", "to": "甲名", "by": "PC-A", "at": "2026-10-23T21:40:00Z" },
        { "from": "周会", "to": "乙名", "by": "PC-B", "at": "2026-10-23T21:40:00Z" }
      ],
      "exists": ["甲名", "乙名"],
      "expect": "乙名"
    },
    {
      "name": "at 平手且 by 也平手（同一台重试）：取列在后面的那条，两端同序",
      "myStem": "周会",
      "entries": [
        { "from": "周会", "to": "甲名", "by": "PC-A", "at": "2026-10-23T21:40:00Z" },
        { "from": "周会", "to": "乙名", "by": "PC-A", "at": "2026-10-23T21:40:00Z" }
      ],
      "exists": ["甲名", "乙名"],
      "expect": "乙名"
    },
    {
      "name": "尽头那个名不在仓里：不跟（半截发布不由标记来兜）",
      "myStem": "周会",
      "entries": [{ "from": "周会", "to": "项目周报", "by": "PC-A", "at": "2026-10-23T21:40:00Z" }],
      "exists": [],
      "expect": null
    },
    {
      "name": "链走到一半，尽头不在：不跟，也不停在半路",
      "myStem": "周会",
      "entries": [
        { "from": "周会", "to": "项目周报", "by": "PC-A", "at": "2026-10-23T21:40:00Z" },
        { "from": "项目周报", "to": "本季复盘", "by": "PC-A", "at": "2026-10-23T22:00:00Z" }
      ],
      "exists": ["项目周报"],
      "expect": null
    },
    {
      "name": "七跳仍在步数内（上限之下要真跟到底）",
      "myStem": "b0",
      "entries": [
        { "from": "b0", "to": "b1", "by": "PC-A", "at": "2026-10-23T00:00:01Z" },
        { "from": "b1", "to": "b2", "by": "PC-A", "at": "2026-10-23T00:00:02Z" },
        { "from": "b2", "to": "b3", "by": "PC-A", "at": "2026-10-23T00:00:03Z" },
        { "from": "b3", "to": "b4", "by": "PC-A", "at": "2026-10-23T00:00:04Z" },
        { "from": "b4", "to": "b5", "by": "PC-A", "at": "2026-10-23T00:00:05Z" },
        { "from": "b5", "to": "b6", "by": "PC-A", "at": "2026-10-23T00:00:06Z" },
        { "from": "b6", "to": "b7", "by": "PC-A", "at": "2026-10-23T00:00:07Z" }
      ],
      "exists": ["b7"],
      "expect": "b7"
    },
    {
      "name": "八跳撞步数上限：不跟（收敛不了的环状脏数据不许拖着一块板乱搬）",
      "myStem": "b0",
      "entries": [
        { "from": "b0", "to": "b1", "by": "PC-A", "at": "2026-10-23T00:00:01Z" },
        { "from": "b1", "to": "b2", "by": "PC-A", "at": "2026-10-23T00:00:02Z" },
        { "from": "b2", "to": "b3", "by": "PC-A", "at": "2026-10-23T00:00:03Z" },
        { "from": "b3", "to": "b4", "by": "PC-A", "at": "2026-10-23T00:00:04Z" },
        { "from": "b4", "to": "b5", "by": "PC-A", "at": "2026-10-23T00:00:05Z" },
        { "from": "b5", "to": "b6", "by": "PC-A", "at": "2026-10-23T00:00:06Z" },
        { "from": "b6", "to": "b7", "by": "PC-A", "at": "2026-10-23T00:00:07Z" },
        { "from": "b7", "to": "b8", "by": "PC-A", "at": "2026-10-23T00:00:08Z" }
      ],
      "exists": ["b8"],
      "expect": null
    },
    {
      "name": "别人的改名与我无关",
      "myStem": "周会",
      "entries": [{ "from": "另一块板", "to": "改了个名", "by": "PC-A", "at": "2026-10-23T21:40:00Z" }],
      "exists": ["改了个名"],
      "expect": null
    }
  ]
}
